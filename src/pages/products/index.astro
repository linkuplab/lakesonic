---
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<h1>Products</h1>

<ul>
    {
        products.map((product) => (
                <li>
                    <h2>{product.data.title}</h2>
                    <p>{product.data.description}</p>
                </li>
        ))
    }
</ul>