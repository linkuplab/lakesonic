---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureCard from "../components/FeatureCard.astro";

---

<MainLayout title="Главная">

		<Hero />

		<section class="features">

			<div class="container features__container">

				<h2>Почему этот курс отличается?</h2>

				<div class="features__grid">

					<FeatureCard
						icon="🚀"
						title="Пошаговое обучение 1"
						text="Каждая тема появляется именно тогда, когда она понадобится в нашем проекте."
					/>

					<FeatureCard
						icon="⚡"
						title="Современный Astro"
						text="Мы изучаем возможности Astro на практике, создавая полноценный сайт."
					/>

					<FeatureCard
						icon="🎯"
						title="Реальный проект"
						text="Вместо отдельных упражнений мы постепенно создаём сайт, похожий на выбранный референс."
					/>

				</div>

			</div>

		</section>

</MainLayout>

<style>
	.features {
		background: var(--color-surface);
	}
	.features__container {
		/* padding-top: 5rem;
		padding-bottom: 5rem; */
		padding-block: 5rem;

	}
	.features__grid {
		display: grid;
		/* grid-template-columns: 1fr 1fr 1fr; */  /* равносильно строке ниже */
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}
	.features h2 {
		text-align: center;
		font-size: 2.25rem;
		margin-bottom: 3rem;
	}
	@media (max-width: 992px) {		/* @media (width <= 992px) */
		.features__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {		/* @media (width <= 768px)	*/
		.features__container {
			padding-top: 2rem;
			padding-bottom: 2rem;
		}

		.features__grid {
			grid-template-columns: 1fr;
		}
	}


</style>