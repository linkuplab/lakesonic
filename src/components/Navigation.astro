---
import { navigation } from "../data/navigation";
---

<nav class="navigation">

    {
        navigation.map((item) => (
                <a href={item.href}>
                    {item.label}
                </a>
        ))
    }

</nav>

<style>
    .navigation {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .navigation__link {
        color: inherit;
        transition: color .2s ease;
        text-decoration: none;
        font-weight: 500;
    }

    .navigation__link:hover {
        /* color: #2f6fed; */
        color: var(--color-primary);
    }

    @media (max-width: 768px) {

        .navigation {
            justify-content: center;
            gap: 1rem 1.5rem;       /*  уменьшить расстояние между элементами */
        }

    }
</style>