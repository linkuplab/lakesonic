---
interface Props {
    title: string;
    text: string;
    icon: string;
}
const {title, text, icon} = Astro.props as Props;
---

<article class="feature-card">

    <div class="feature-card__icon">
        {icon}
    </div>

    <h3>{title}</h3>

    <p>{text}</p>

</article>

<style>

    .feature-card {
        height: 100%;           /*  Это решение особенно полезно, если карточки находятся в Grid    */
        background: white;
        border: 1px solid var(--color-border-card);
        border-radius: 12px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        transition:                                  /*  замедление подьема Up карточек*/
                transform .2s ease,
                box-shadow .2s ease;
    }
    .feature-card:hover {
        transform: translateY(-4px);                 /*   смещение карточек  */
        box-shadow: 0 12px 24px rgba(0,0,0,.08);
    }

    .feature-card__icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .feature-card h3 {
        margin-bottom: .75rem;
    }

    .feature-card p {
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

</style>