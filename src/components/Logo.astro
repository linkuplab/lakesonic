---
import logo from "../assets/logo/brand-logo-white.webp";
---
<a href="/" class="logo" aria-label="Lakesonic home">
    <img src={logo} alt="Lakesonic" />
</a>

<style>
    .logo {
        display: block;
        flex: none;
    }

    .logo img {
        display: block;
        width: 201px;
        height: auto;
    }

    .logo:hover {
        opacity: 0.8;
    }
</style>