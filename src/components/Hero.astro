---
import { hero } from "../data/hero";

import { Image } from "astro:assets";
import heroImage from "../assets/hero/hero-image-light.webp";
import heroElementOne from "../assets/hero/hero-image-element-one.webp";
import heroElementTwo from "../assets/hero/hero-image-element-two.webp";
import Button from "./Button.astro";
---

<section class="hero">

    <div class="container hero__container">

        <div class="hero__content">

            <h1>{hero.title}</h1>

            <p>{hero.description}</p>

            <Button text={hero.buttonText} />

        </div>

        <div class="hero__visual">

            <div class="hero__element hero__element--one">
                <Image
                        src={heroElementOne}
                        alt="Analytics statistics"
                        width={260}
                        height={377}
                />
            </div>

            <div class="hero__dashboard">
                <Image
                        src={heroImage}
                        alt="Lakesonic analytics dashboard"
                        width={926}
                        height={537}
                        loading="eager"
                />
            </div>

            <div class="hero__element hero__element--two">
                <Image
                        src={heroElementTwo}
                        alt="Analytics overview"
                        width={328}
                        height={275}
                />
            </div>

        </div>

    </div>

</section>

<style>

    .hero {
        padding: 5rem 0 3rem;
    }

    /* ===== Text ===== */
    .hero__container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero__content {
        width: 100%;
        max-width: 760px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        text-align: center;
        margin-bottom: 4rem;
    }

    .hero__content h1 {
        max-width: 760px;
    }

    .hero__content p {
        max-width: 650px;
        font-size: 1.2rem;
        color: var(--color-text-secondary);
    }

    /* ===== Hero visual ===== */
    .hero__visual {
        position: relative;
        width: 100%;
        max-width: 1200px;
        min-height: 556px;
        display: flex;
        justify-content: center;
        align-items: center;

    }

    /* ===== Main dashboard ===== */
    .hero__dashboard {
        position: relative;
        z-index: 2;
        width: 960px;
        max-width: 100%;
        overflow: hidden;
    }

    .hero__dashboard img {
        display: block;
        width: 960px;
        height: auto;
    }

    .hero__element {
        position: absolute;
        z-index: 3;
        display: block;
        pointer-events: none;
        border-radius: 16px;
        overflow: hidden;
    }

    .hero__element img {
        display: block;
        width: 100%;
        height: auto;
    }

    /* LEFT */
    .hero__element--one {
        left: 0;
        top: 50%;
        width: 258px;
        transform: translateY(-50%);
        animation: hero-float-left 5s ease-in-out infinite;
        box-shadow: 0 16px 60px #02031573;

    }

    /* RIGHT */
    .hero__element--two {
        right: 0;
        top: 50%;
        width: 328px;
        transform: translateY(-50%);
        animation: hero-float-right 6s ease-in-out infinite;
        animation-delay: -1.5s;
        box-shadow: 0 16px 80px #02031573;
    }


    @keyframes hero-float-left {
        0%,
        100% {
            transform: translateY(-50%);
        }

        50% {
            transform: translateY(calc(-50% - 14px));
        }
    }

    @keyframes hero-float-right {
        0%,
        100% {
            transform: translateY(-50%);
        }

        50% {
            transform: translateY(calc(-50% + 12px));
        }
    }

    /* ===== Tablet ===== */
    @media (max-width: 992px) {

        .hero__card {
            width: 170px;
        }

        .hero__card--left {
            left: 0;
        }

        .hero__card--right {
            right: 0;
        }

    }

    /* ===== Mobile ===== */
    @media (max-width: 768px) {
        .hero {
            padding: 3rem 0;
        }

        .hero__content {
            margin-bottom: 3rem;
        }

        .hero__content h1 {
            font-size: 2.2rem;
        }

        .hero__content p {
            font-size: 1rem;
        }

        .hero__visual {
            min-height: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2rem;
        }

        .hero__dashboard {
            order: 1;
            width: 100%;
            max-width: 500px;
        }

        .hero__card {
            position: static;
            width: 100%;
            max-width: 320px;
            transform: none;
            animation: none;
        }
        .hero__element {
            position: static;
            transform: none;
            animation: none;
            width: auto;
        }

        .hero__element--one {
            order: 2;
            width: 258px;
        }

        .hero__element--two {
            order: 3;
            width: 320px;
        }
        /*
        .hero__card--left {
            order: 2;
        }
        */
        /*
        .hero__card--right {
            order: 3;
        }
        */
    }

</style>